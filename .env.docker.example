# Copia este archivo como .env en la raíz antes de arrancar Docker Compose.
# Genera APP_KEY con:
# docker compose run --rm backend php artisan key:generate --show
APP_KEY=

# Credenciales de MariaDB. Cambia estas claves antes de usar un entorno público.
DB_DATABASE=beango
DB_USERNAME=beango
DB_PASSWORD=beango
DB_ROOT_PASSWORD=root

# URLs expuestas por Docker Compose
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
ADMIN_URL=http://localhost:8081
VITE_API_URL=http://localhost:8000/api/v1
