# Proxy inverso de producción. Caddy pide y renueva solo los certificados
# HTTPS (Let's Encrypt, con ZeroSSL de respaldo) y redirige HTTP → HTTPS.
#
# BEANGO_DOMAIN sale del .env del EC2 (ver docker-compose.prod.yml).
# Provisional: <ip-con-guiones>.sslip.io, que resuelve a esa IP sin
# configurar DNS. Con dominio propio (playbeango.com) apuntar en el DNS la
# raíz, www., admin. y api. a la IP del EC2 y recompilar front/admin.

(common) {
	encode zstd gzip
}

{$BEANGO_DOMAIN} {
	import common
	reverse_proxy front:80
}

www.{$BEANGO_DOMAIN} {
	redir https://{$BEANGO_DOMAIN}{uri} permanent
}

admin.{$BEANGO_DOMAIN} {
	import common
	reverse_proxy admin:80
}

api.{$BEANGO_DOMAIN} {
	import common
	reverse_proxy backend:80
}
