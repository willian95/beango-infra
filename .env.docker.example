# Copia este archivo como .env en la raíz antes de arrancar Docker Compose.
# Genera APP_KEY con:
# docker compose run --rm backend php artisan key:generate --show
APP_KEY=

# Credenciales de MariaDB. Cambia estas claves antes de usar un entorno público.
DB_DATABASE=beango
DB_USERNAME=beango
DB_PASSWORD=beango
DB_ROOT_PASSWORD=root

# URLs expuestas por Docker Compose
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
ADMIN_URL=http://localhost:8081

# Solo usado por docker-compose.yml (build local). En producción
# (docker-compose.prod.yml) este valor NO se lee de aquí: se fija como
# repository variable VITE_API_URL en GitHub Actions de beango-front y
# beango-admin, porque queda incrustado en el JS al compilar la imagen.
# Ver infra/CI.md.
VITE_API_URL=http://localhost:8000/api/v1

# Solo usado por docker-compose.prod.yml: dominio base del proxy (Caddy).
# Landing en https://www.$BEANGO_DOMAIN (la raíz redirige ahí), front (la app) en
# https://app.$BEANGO_DOMAIN, admin en https://admin.$BEANGO_DOMAIN y
# API en https://api.$BEANGO_DOMAIN. En prod APP_URL, FRONTEND_URL,
# ADMIN_URL y VITE_API_URL deben usar esas URLs. Ver infra/DEPLOY.md.
# BEANGO_DOMAIN=playbeango.com

# Solo usados por docker-compose.prod.yml, para elegir qué namespace/tag de
# Docker Hub desplegar. Los valores por defecto (willian95 / latest) sirven
# para el flujo normal de CI/CD.
# DOCKERHUB_NAMESPACE=willian95
# BACKEND_TAG=latest
# FRONT_TAG=latest
# ADMIN_TAG=latest
# LANDING_TAG=latest
