# Proxy inverso de producción. Caddy pide y renueva solo los certificados
# HTTPS (Let's Encrypt, con ZeroSSL de respaldo) y redirige HTTP → HTTPS.
#
# BEANGO_DOMAIN sale del .env del EC2 (ver docker-compose.prod.yml).
# Registros A necesarios en el DNS (todos a la IP del EC2): @, www, app,
# admin y api. Sin alguno, Caddy no consigue el certificado de ese host.
#
#   https://www.<dominio>    landing (sitio estático, Astro)
#   https://<dominio>        redirige a https://www.<dominio>
#   https://app.<dominio>    front (la app)
#   https://admin.<dominio>  admin
#   https://api.<dominio>    backend

(common) {
	encode zstd gzip
}

www.{$BEANGO_DOMAIN} {
	import common
	reverse_proxy landing:80
}

{$BEANGO_DOMAIN} {
	redir https://www.{$BEANGO_DOMAIN}{uri} permanent
}

app.{$BEANGO_DOMAIN} {
	import common
	reverse_proxy front:80
}

admin.{$BEANGO_DOMAIN} {
	import common
	reverse_proxy admin:80
}

api.{$BEANGO_DOMAIN} {
	import common
	reverse_proxy backend:80
}
